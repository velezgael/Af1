# Copia este archivo como .env y llena tus datos. NUNCA subas .env a GitHub.

# --- Claude (Anthropic) --- https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo y nivel de esfuerzo (low = respuestas más rápidas, mejor para teléfono)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# --- Twilio --- https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Tu número de Twilio en formato +52...
TWILIO_FROM_NUMBER=

# URL pública de este servidor (por ejemplo la de ngrok: https://abcd-123.ngrok-free.app)
PUBLIC_BASE_URL=
# Verifica que las peticiones vengan de Twilio (déjalo en true en producción)
VALIDATE_TWILIO_SIGNATURE=true

# Opcional: número de un vendedor humano para transferir a los interesados
HUMAN_TRANSFER_NUMBER=

# --- Voz e idioma ---
LANGUAGE=es-MX
VOICE=Polly.Mia-Neural

# --- Reglas de llamadas ---
TIMEZONE=America/Mexico_City
CALL_START_HOUR=9
CALL_END_HOUR=19
# 0=lunes ... 6=domingo
CALL_DAYS=0,1,2,3,4
MAX_TURNS=20
MAX_SILENCES=2
DEFAULT_COUNTRY_CODE=52
